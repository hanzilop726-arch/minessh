<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101714"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="#17231F"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <ImageButton
            android:id="@+id/terminal_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back to hosts"
            android:src="@android:drawable/ic_media_previous"
            app:tint="#F3F4EF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp">

            <TextView
                android:id="@+id/terminal_host_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#F3F4EF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/terminal_status_dot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/ssh_status_dot" />

                <TextView
                    android:id="@+id/terminal_connection_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Starting connection"
                    android:textColor="#B7C3BC"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/terminal_keyboard"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Show keyboard"
            android:src="@android:drawable/ic_menu_edit"
            app:tint="#D8F26A" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#293630" />

    <com.termux.view.TerminalView
        android:id="@+id/ssh_terminal_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#101714"
        android:defaultFocusHighlightEnabled="false"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:scrollbars="vertical" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="#17231F"
        android:fillViewport="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_esc"
                style="@style/SshTerminalKeyButton"
                android:text="ESC" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_tab"
                style="@style/SshTerminalKeyButton"
                android:text="TAB" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_ctrl"
                style="@style/SshTerminalKeyButton"
                android:text="CTRL" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_alt"
                style="@style/SshTerminalKeyButton"
                android:text="ALT" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_up"
                style="@style/SshTerminalKeyButton"
                android:text="UP" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_down"
                style="@style/SshTerminalKeyButton"
                android:text="DOWN" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_pipe"
                style="@style/SshTerminalKeyButton"
                android:text="|" />
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>